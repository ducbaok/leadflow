# ---------------------------------------------------------------------------
# Bắt buộc
# ---------------------------------------------------------------------------

# Supabase Postgres — dùng Supavisor SESSION mode (port 5432), không phải transaction mode (6543)
# Lấy từ: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Bí mật ký session cookie (demo 1-click). Sinh bằng: openssl rand -hex 32
# BẮT BUỘC ở production — thiếu là app ném lỗi khi tạo session (src/lib/session.ts)
SESSION_SECRET=

# ---------------------------------------------------------------------------
# AI scoring (F3) — thiếu ANTHROPIC_API_KEY thì job score.ai bỏ qua an toàn,
# rule scoring vẫn chạy bình thường
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
# Model đổi được qua env — không hardcode trong code (ADR-007)
AI_SCORING_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Chỉ dùng cho môi trường DEMO PUBLIC (Railway). Để TRỐNG ở local và CI.
# ---------------------------------------------------------------------------

# Rào chi phí AI (ADR-010). Trống = tắt rào, hành vi y hệt local.
# Trần số lead mỗi lần bấm "Score with AI" (min với scoring_config.ai_top_n)
AI_MAX_LEADS_PER_RUN=
# Số giây tối thiểu giữa 2 lần chạy AI; gọi sớm hơn → HTTP 429
AI_RUN_COOLDOWN_SECONDS=

# Bật POST /api/admin/reset (xoá + seed lại demo). Trống = route trả 503, coi như không tồn tại.
# Sinh bằng: openssl rand -hex 24. Gọi:
#   curl -X POST -H "x-admin-token: $ADMIN_RESET_TOKEN" https://<domain>/api/admin/reset
ADMIN_RESET_TOKEN=
